---
import { CharactersApp } from "../components/characters/CharactersApp.js";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Characters — Diablo Immortal Planner">
	<h1 class="text-2xl font-semibold text-neutral-100">Characters</h1>
	<p class="mt-2 max-w-2xl text-neutral-400">
		Add servers, create and archive characters (up to five per server), and see each character's independent
		goals, progression, and task state.
	</p>
	<div class="mt-6">
		<CharactersApp client:only="react" />
	</div>
</Layout>
